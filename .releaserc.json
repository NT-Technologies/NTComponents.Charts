{
  "repositoryUrl": "https://github.com/NT-Technologies/NTComponents.Charts.git",
  "branches": [
    "main",
    {
      "name": "preview",
      "prerelease": "preview",
      "channel": "preview"
    }
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": []
      }
    ]
  ]
}
