@inherits NTComponents.Core.NTDisposableComponentBase
@typeparam TData

<div @attributes="AdditionalAttributes" class="@ElementClass" id="@ElementId" lang="@ElementLang" style="@ElementStyle" @ref="@Element">
	<CascadingValue Value="this" IsFixed="true">
		@ChildContent
	</CascadingValue>
	<div class="nt-chart-canvas-host"
		 @ref="_interactionHost"
		 @onmouseleave="OnMouseOut" @onclick="OnClick"
		 @onmousedown="OnMouseDown" @onmouseup="OnMouseUp"
		 style="width: 100%; height: 100%; @CanvasStyle">
		@RenderCanvas
	</div>
	@if (AllowExport || IsXPanEnabled || IsYPanEnabled || IsXZoomEnabled || IsYZoomEnabled) {
		<div class="nt-chart-buttons">
			@if (AllowExport) {
				<NTIconButton ButtonSize="NTSize.Smallest" Variant="NTButtonVariant.Text" Icon="@MaterialIcon.Download" AriaLabel="Export chart as PNG" ElementTitle="Export chart as PNG" OnClickCallback="@(() => ExportAsPngAsync())" />
			}

			@if (IsXPanEnabled || IsYPanEnabled || IsXZoomEnabled || IsYZoomEnabled) {
				<NTIconButton ButtonSize="NTSize.Smallest" Variant="NTButtonVariant.Text" Icon="@MaterialIcon.Refresh" AriaLabel="Reset chart view" ElementTitle="Reset chart view" OnClickCallback="@(() => ResetView())" />
			}
		</div>
	}
</div>
