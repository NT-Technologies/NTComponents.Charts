<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
    </PropertyGroup>

    <PropertyGroup>
        <!-- SkiaSharp 4.150.1 WebAssembly assets use Emscripten 3.1.56 and cannot native-link with .NET 11's Emscripten 5 toolchain. -->
        <WasmBuildNative Condition="'$(WasmBuildNative)' == '' and '$(TargetFramework)' == 'net10.0'">true</WasmBuildNative>
        <WasmBuildNative Condition="'$(WasmBuildNative)' == ''">false</WasmBuildNative>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\NTComponents.Charts\NTComponents.Charts.csproj" AdditionalProperties="UseLocalNTComponentsProject=false" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-preview.6.26359.118" />
    </ItemGroup>

</Project>
