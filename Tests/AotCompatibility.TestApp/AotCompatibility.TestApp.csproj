<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
    </PropertyGroup>

    <PropertyGroup>
        <!-- SkiaSharp 4.153.1 assets use Emscripten 3.1.56; .NET 11 RC uses Emscripten 6 and cannot link them. The net11 target validates trimming only. -->
        <WasmBuildNative Condition="'$(WasmBuildNative)' == '' and '$(TargetFramework)' == 'net10.0'">true</WasmBuildNative>
        <WasmBuildNative Condition="'$(WasmBuildNative)' == ''">false</WasmBuildNative>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\NTComponents.Charts\NTComponents.Charts.csproj" AdditionalProperties="UseLocalNTComponentsProject=false" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>

</Project>
