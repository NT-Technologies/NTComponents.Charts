<main data-aot-smoke-ready="true">
    <h1>NTComponents.Charts AOT smoke</h1>

    <div style="height: 320px; width: 640px;">
        <NTChart TData="SmokePoint" EnableHardwareAcceleration="false">
            <NTXAxisOptions ValueSelector="@(point => point.X)" Title="X" />
            <NTYAxisOptions ValueSelector="@(point => point.Y)" Title="Y" />
            <NTLineSeries TData="SmokePoint" Data="_points" XValue="@(point => point.X)" YValueSelector="@(point => point.Y)" />
        </NTChart>
    </div>
</main>

@code {
    private readonly IReadOnlyList<SmokePoint> _points = [
        new(0, 1),
        new(1, 3),
        new(2, 2)
    ];

    private sealed record SmokePoint(double X, decimal Y);
}
